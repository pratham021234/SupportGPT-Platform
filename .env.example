# ==============================================================================
# SUPPORTGPT AI — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development with Docker Compose.
# NEVER commit production credentials or secrets to version control.
# ==============================================================================

# Project & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=SupportGPT-AI

# PostgreSQL Configuration
POSTGRES_USER=supportgpt_user
POSTGRES_PASSWORD=supportgpt_dev_password
POSTGRES_DB=supportgpt_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant Vector DB Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration (Exposed to browser via NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
