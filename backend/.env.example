# Backend Environment Configuration
ENVIRONMENT=development
APP_NAME=SupportGPT-AI
LOG_LEVEL=INFO
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# PostgreSQL Database (Async driver required for SQLAlchemy 2.x async engine)
DATABASE_URL=postgresql+asyncpg://supportgpt_user:supportgpt_dev_password@localhost:5432/supportgpt_db

# Redis Cache / Queue
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Engine
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
