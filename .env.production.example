# ==============================================================================
# SupportGPT AI Platform - Production Environment Template
# ==============================================================================
# IMPORTANT: This file contains configuration placeholders ONLY.
# NEVER commit real passwords, cryptographic keys, or API credentials to git.
# In production, inject secrets via AWS Secrets Manager, HashiCorp Vault,
# GitHub Actions environment secrets, or a secure secret manager.
# ==============================================================================

# Core Runtime Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME=SupportGPT-AI
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Networking & Ingress
PORT=80
PUBLIC_API_URL=https://app.example.com/api
CORS_ORIGINS=["https://app.example.com"]

# Relational Database (PostgreSQL 16)
POSTGRES_USER=supportgpt_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_MIN_32_CHARS
POSTGRES_DB=supportgpt_prod_db
DATABASE_URL=postgresql+asyncpg://supportgpt_prod_user:REPLACE_WITH_STRONG_RANDOM_PASSWORD_MIN_32_CHARS@postgres:5432/supportgpt_prod_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Dedicated Backup Connection (BYPASSRLS role for pg_dump disaster recovery)
BACKUP_DATABASE_URL=postgresql://supportgpt_backup:REPLACE_WITH_STRONG_BACKUP_PASSWORD@postgres:5432/supportgpt_prod_db

# Asynchronous Cache & Broker (Redis 7)
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_AUTH_PASSWORD_MIN_32_CHARS
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_AUTH_PASSWORD_MIN_32_CHARS@redis:6379/0

# Semantic Vector Store (Qdrant v1.12)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=supportgpt_chunks
QDRANT_API_KEY=REPLACE_WITH_QDRANT_CLUSTER_API_KEY_IF_AUTHENTICATED

# Authentication & Session Security (OWASP Invariants)
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_KEY_MIN_32_HEX_CHARS
SESSION_COOKIE_NAME=supportgpt_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_HTTPONLY=true
SESSION_DURATION_SECONDS=86400
SESSION_SLIDING_WINDOW_SECONDS=3600
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Webhook Payload Signature & Encryption
# Generate with: openssl rand -hex 32
WEBHOOK_SECRETS_ENCRYPTION_KEY=REPLACE_WITH_AES256_GCM_ENCRYPTION_KEY_MIN_32_CHARS
INGESTION_TIMESTAMP_TOLERANCE_SECONDS=300
INGESTION_MAX_ATTEMPTS=5
INGESTION_LEASE_TIMEOUT_SECONDS=300

# Background Worker & Pipeline Concurrency
BACKEND_WORKERS=4
ENABLE_INGESTION_WORKER=false
ENABLE_DOCUMENT_WORKER=false
DOCUMENT_PROCESSING_POLL_INTERVAL_SECONDS=2.0
DOCUMENT_PROCESSING_BATCH_SIZE=10

# AI Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=sk-proj-REPLACE_WITH_ACTIVE_OPENAI_API_KEY
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Dense Semantic Embeddings
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Local Storage Persistence
STORAGE_LOCAL_BASE_PATH=/app/storage_data
MAX_FILE_SIZE_BYTES=26214400
ALLOWED_MEDIA_TYPES=["text/plain","text/markdown","application/pdf"]
